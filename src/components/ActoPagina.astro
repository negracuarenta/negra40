---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from './Layout.astro';
import ActoTexto from './ActoTexto.astro';
import { ACTOS, IDIOMAS, leerActo, tituloActo } from '../lib/actos';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const i = ACTOS.findIndex((a) => a.slug === slug);
if (i < 0) throw new Error(`Acto desconocido: ${slug}`);
const acto = ACTOS[i];
const anterior = ACTOS[i - 1];
const siguiente = ACTOS[i + 1];

// Los tres idiomas del guion, uno debajo del otro. No es el idioma del sitio:
// la obra se publica entera en los tres, y quien entra por la versión inglesa
// encuentra igual el castellano y el alemán.
const versiones = IDIOMAS.map((idioma) => ({
  ...idioma,
  bloques: leerActo(acto.n, idioma.codigo),
}));

const ficha = getRelativeLocaleUrl(lang, '/proyectos/nido/');
const url = (a: (typeof ACTOS)[number]) =>
  getRelativeLocaleUrl(lang, `/proyectos/nido/${a.slug}/`);

const rotulos =
  lang === 'en'
    ? {
        obra: 'Texts from the work',
        enTres: 'The act, in full, in three languages',
        anterior: 'Previous',
        siguiente: 'Next',
      }
    : {
        obra: 'Textos de la obra',
        enTres: 'El acto completo, en tres idiomas',
        anterior: 'Anterior',
        siguiente: 'Siguiente',
      };
---

<Layout
  lang={lang}
  title={`${tituloActo(acto, lang)} — NIDO`}
  description={rotulos.enTres}
  current="proyectos"
  path={`/proyectos/nido/${acto.slug}/`}
>
  <div class="ficha-header">
    <p><a class="link link--meta" href={ficha}>← NIDO · {rotulos.obra}</a></p>
    <h1>{tituloActo(acto, lang)}</h1>
    <p class="acto-bajada">{rotulos.enTres}</p>
    <ul class="acto-idiomas">
      {
        versiones.map((v) => (
          <li>
            <a class="link link--meta" href={`#${v.codigo}`} lang={v.htmlLang}>
              {v.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    versiones.map((v) => (
      <section class="acto-version" id={v.codigo} lang={v.htmlLang}>
        <h2 class="acto-idioma">{v.nombre}</h2>
        <ActoTexto bloques={v.bloques} />
      </section>
    ))
  }

  <nav class="acto-nav" aria-label={rotulos.obra}>
    <div>
      {
        anterior && (
          <a class="link link--meta" href={url(anterior)}>
            ← {tituloActo(anterior, lang)}
          </a>
        )
      }
    </div>
    <div class="acto-nav__centro">
      <a class="link link--meta" href={ficha}>{rotulos.obra}</a>
    </div>
    <div class="acto-nav__fin">
      {
        siguiente && (
          <a class="link link--meta" href={url(siguiente)}>
            {tituloActo(siguiente, lang)} →
          </a>
        )
      }
    </div>
  </nav>
</Layout>

<style>
  .acto-bajada {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-top: 0.4rem;
  }

  /* Los tres idiomas, como atajo arriba de todo: la página es larga y hay que
     poder caer directo en el propio. */
  .acto-idiomas {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Cada idioma arranca con una regla y su nombre, para que no quede duda de
     dónde termina uno y empieza el otro. */
  .acto-version {
    margin-top: var(--space-5);
    scroll-margin-top: var(--space-3);
  }

  .acto-version:first-of-type {
    margin-top: var(--space-4);
  }

  .acto-idioma {
    max-width: var(--measure);
    margin: 0 auto var(--space-3);
    padding-inline: var(--space-2);
    padding-top: var(--space-2);
    border-top: 2px solid var(--color-fg);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 800;
    font-size: 0.8rem;
  }

  .acto-nav {
    max-width: var(--measure);
    margin: var(--space-5) auto var(--space-5);
    padding-inline: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .acto-nav__centro {
    text-align: center;
  }

  .acto-nav__fin {
    text-align: right;
  }

  @media (max-width: 36rem) {
    .acto-nav {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .acto-nav__fin {
      text-align: center;
    }
  }
</style>
