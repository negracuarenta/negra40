---
import { getEntry, render } from 'astro:content';
import Layout from './Layout.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  current: 'home' | 'negra40' | 'proyectos' | 'textos' | 'links' | 'contacto';
  path: string;
}

const { lang, slug, current, path } = Astro.props;
const page = await getEntry('paginas', `${lang}/${slug}`);
const { Content } = await render(page!);

// Cuando el título de la página es el nombre de la marca, no se escribe: ya lo
// dice el isologo del header. Queda igual en el HTML, oculto, porque la página
// necesita un h1 para lectores de pantalla y buscadores.
const isSiteName = page!.data.title.replace(/\s+/g, '').toLowerCase() === 'negra40';
---

<Layout lang={lang} title={page!.data.title} current={current} path={path}>
  <div class:list={['prose', 'page-prose', isSiteName && 'page-prose--sin-titulo']}>
    <h1 class:list={[isSiteName && 'visually-hidden']}>{page!.data.title}</h1>
    <Content />
  </div>
</Layout>
