---
import { getEntry, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from './Layout.astro';
import Gallery from './Gallery.astro';
import AudioEmbed from './AudioEmbed.astro';
import { t, type Lang } from '../i18n/ui';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const entry = await getEntry('proyectos', `${lang}/${slug}`);
if (!entry) throw new Error(`Proyecto not found: ${lang}/${slug}`);
const { Content } = await render(entry);
const [cover, ...rest] = entry.data.images;

const agendaLabels =
  lang === 'en' ? { date: 'Date', place: 'Place' } : { date: 'Fecha', place: 'Lugar' };
const dateLabel = entry.data.date
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(entry.data.date)
  : null;
---

<Layout
  lang={lang}
  title={entry.data.title}
  description={entry.data.location}
  current="proyectos"
  path={`/proyectos/${slug}/`}
>
  <div class="ficha-header">
    <p><a href={getRelativeLocaleUrl(lang, '/proyectos/')}>{t(lang, 'back_to_proyectos')}</a></p>
    <h1>{entry.data.title}</h1>
  </div>

  {
    (dateLabel || entry.data.location) && (
      <dl class="ficha-agenda">
        {dateLabel && (
          <div>
            <dt>{agendaLabels.date}</dt>
            <dd>{dateLabel}</dd>
          </div>
        )}
        {entry.data.location && (
          <div>
            <dt>{agendaLabels.place}</dt>
            <dd>{entry.data.location}</dd>
          </div>
        )}
      </dl>
    )
  }

  {
    cover && (
      <div class="ficha-cover">
        <img src={withBase(cover)} alt={entry.data.title} loading="eager" />
      </div>
    )
  }

  <div class="prose">
    <Content />
  </div>

  {entry.data.audio && <AudioEmbed lang={lang} audio={entry.data.audio} />}

  {
    entry.data.germanNote && (
      <div class="prose" style="color: var(--color-muted); font-size: 0.95rem; border-top: 1px solid var(--color-border); padding-top: 1rem; white-space: pre-line;">
        {entry.data.germanNote}
      </div>
    )
  }

  {rest.length > 0 && <Gallery images={rest} alt={entry.data.title} />}
</Layout>
