---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { slugOf } from '../lib/proyectos';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'proyectos'>;
}

const { lang, entry } = Astro.props;
const cover = entry.data.images[0];
const year = entry.data.date ? new Date(entry.data.date).getFullYear() : null;
const formatoFecha = {
  dia: { day: 'numeric', month: 'short', year: 'numeric' },
  mes: { month: 'short', year: 'numeric' },
  anio: { year: 'numeric' },
}[entry.data.datePrecision] as Intl.DateTimeFormatOptions;
// Las fechas del contenido no llevan hora: Astro las guarda como medianoche
// UTC. Sin fijar la zona, formatearlas en un huso negativo las corre un día
// hacia atrás y el sitio mostraría fechas distintas según dónde se compile.
formatoFecha.timeZone = 'UTC';
const dateLabel = entry.data.date
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-ES', formatoFecha).format(entry.data.date)
  : null;
const slug = slugOf(entry);
---

<a class="card" href={getRelativeLocaleUrl(lang, `/proyectos/${slug}/`)} data-title={entry.data.title.toLowerCase()} data-year={year ?? ''}>
  {
    cover && (
      <span class="card__frame">
        <img src={withBase(cover)} alt={entry.data.title} loading="lazy" />
      </span>
    )
  }
  {dateLabel && <span class="card-date">{dateLabel}</span>}
  <h3>{entry.data.title}</h3>
</a>
