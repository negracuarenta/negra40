---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../lib/paths';

interface Props {
  /** Ruta en public/ que se usa si todavía no hay fotos en public/landing/. */
  fallback?: string | null;
  fallbackAlt?: string;
}

const { fallback = null, fallbackAlt = '' } = Astro.props;

// Las fotos del slideshow salen de public/landing/, leída en tiempo de build:
// subir una imagen nueva a esa carpeta alcanza para que entre a la rotación,
// sin tocar código. Si la carpeta no existe o está vacía, se cae a `fallback`
// (hoy, la imagen del proyecto más reciente) para no romper el landing.
function readLandingImages(): string[] {
  try {
    return readdirSync(join(process.cwd(), 'public', 'landing'))
      .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
      .sort();
  } catch {
    return [];
  }
}

const files = readLandingImages();
const slides = files.length
  ? files.map((file) => ({ src: withBase(`landing/${file}`), alt: '' }))
  : fallback
    ? [{ src: withBase(fallback), alt: fallbackAlt }]
    : [];
---

{
  slides.length > 0 && (
    <div class="hero-slideshow" data-interval="4500">
      {slides.map((slide, i) => (
        <img
          class:list={['hero-slideshow__slide', i === 0 && 'is-active']}
          src={i === 0 ? slide.src : undefined}
          data-src={i === 0 ? undefined : slide.src}
          alt={slide.alt}
          loading="eager"
          decoding="async"
        />
      ))}
    </div>
  )
}

<script>
  // Rotación automática, en loop y sin controles: el usuario no interactúa.
  // Quien pidió menos movimiento en el sistema se queda con la primera foto.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Solo la primera foto trae `src` en el HTML; las demás llegan con `data-src`
  // y se piden desde acá, un par de slides por delante de la que se ve. Así el
  // landing no arranca descargando todas las fotos de golpe, y a la vez ninguna
  // depende de `loading="lazy"`, que no las traía por estar apiladas y en
  // opacidad 0 (la rotación pasaba a imágenes vacías).
  function hydrate(slide: HTMLImageElement | undefined) {
    if (!slide) return;
    const src = slide.dataset.src;
    if (!src) return;
    slide.src = src;
    delete slide.dataset.src;
  }

  for (const box of document.querySelectorAll<HTMLElement>('.hero-slideshow')) {
    const slides = Array.from(box.querySelectorAll<HTMLImageElement>('.hero-slideshow__slide'));
    if (reduced || slides.length < 2) continue;

    const interval = Number(box.dataset.interval) || 4500;
    let current = 0;

    const preloadAhead = () => {
      hydrate(slides[(current + 1) % slides.length]);
      hydrate(slides[(current + 2) % slides.length]);
    };

    preloadAhead();

    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
      preloadAhead();
    }, interval);
  }
</script>
