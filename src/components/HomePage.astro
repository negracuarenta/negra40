---
import { getEntry, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from './Layout.astro';
import ProjectCard from './ProjectCard.astro';
import { t, type Lang } from '../i18n/ui';
import { getProyectos, slugOf } from '../lib/proyectos';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = await getEntry('paginas', `${lang}/inicio`);
const { Content } = await render(page!);
const proyectos = await getProyectos(lang);
const featured = proyectos.slice(0, 6);

// Imagen del landing: la del proyecto más reciente del listado ya ordenado, así
// se actualiza sola cuando cargan un proyecto nuevo. Varias fichas arrancan con
// una imagen cuadrada de afiche, que recortada en panorámico pierde el título:
// si alguna imagen declara sus medidas en el nombre (patrón de WordPress, p. ej.
// "…-1024x614.webp"), se prefiere la primera apaisada; si no, se descartan las
// marcadas como cuadradas ("1x1") y se cae a la primera de la lista.
function pickHeroImage(images: string[]): string | null {
  const measured = images
    .map((src) => ({ src, size: /-(\d+)x(\d+)\.[a-z0-9]+$/i.exec(src) }))
    .filter((i) => i.size);
  const landscape = measured.find((i) => Number(i.size![1]) > Number(i.size![2]));
  if (landscape) return landscape.src;
  return images.find((src) => !/[_-]1x1[._-]/i.test(src)) ?? images[0] ?? null;
}

const latest = proyectos[0];
const heroImage = latest ? pickHeroImage(latest.data.images) : null;
const heroDate = latest?.data.date
  ? new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-ES', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(latest.data.date)
  : null;
---

<Layout lang={lang} title="negra40" current="home" path="/">
  <section class="hero">
    <div class="container">
      <h1>negra 40</h1>
      <div class="subtitle">
        <Content />
      </div>
    </div>
  </section>

  {
    heroImage && latest && (
      <a class="home-hero" href={getRelativeLocaleUrl(lang, `/proyectos/${slugOf(latest)}/`)}>
        <img src={withBase(heroImage)} alt={latest.data.title} loading="eager" />
        <span class="home-hero__caption">
          {heroDate && <span class="home-hero__date">{heroDate}</span>}
          <span class="home-hero__title">{latest.data.title}</span>
        </span>
      </a>
    )
  }

  <div class="container-wide">
    <h2 style="padding-inline: 1rem;">{t(lang, 'nav_proyectos')}</h2>
  </div>
  <div class="featured-grid">
    {featured.map((entry) => <ProjectCard lang={lang} entry={entry} />)}
  </div>
  <p style="text-align:center; padding: 2rem;">
    <a class="btn" href={getRelativeLocaleUrl(lang, '/proyectos/')}>{t(lang, 'read_more')}</a>
  </p>
</Layout>
